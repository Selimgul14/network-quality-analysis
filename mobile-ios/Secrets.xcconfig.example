// Copy to Secrets.xcconfig and fill in. Secrets.xcconfig is gitignored:
// never commit it (CONSTRAINTS.md C5). Mirrors src/.env.
//
// NOTE: `//` starts a comment in an xcconfig file, so a full URL like
// https://host silently truncates to "https:". Hosts are therefore stored
// bare here and the scheme is added in Swift.

// Identity. C2: probe_id must never start with "pi-".
PROBE_ID = iphone-dev-01

// Backend. Bare hosts, no scheme.
API_HOST = comp702-api.azurewebsites.net
CLOUD_REF_HOST = comp702-ref.azurewebsites.net

// POST /ingest bearer token (same value as PROBE_INGEST_TOKEN in src/.env).
INGEST_TOKEN =

// HTTP Basic on the dashboard endpoints, needed for GET /summary.
// The query API and the ingest endpoint use different credentials.
DASH_USER = wifi
DASH_PASS =

// Real-world targets, matching src/.env so both probes measure the same
// services. Scheme-less for the reason above; REAL_DOWNLOAD is cleartext
// HTTP and needs the ATS exception in Info.plist.
REAL_WEB = www.bbc.co.uk/news
REAL_VIDEO = test-videos.co.uk/vids/bigbuckbunny/mp4/h264/720/Big_Buck_Bunny_720_10s_1MB.mp4
REAL_DOWNLOAD = ipv4.download.thinkbroadband.com/50MB.zip
REAL_DOWNLOAD_SCHEME = http
