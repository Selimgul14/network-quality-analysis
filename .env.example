# Copy to .env and fill in. .env is gitignored: never commit secrets.

# --- Probe ---
PROBE_PROBE_ID=pi-maple-01
# deployment label for grouping results by network/location (empty = unset)
PROBE_SITE=
PROBE_INGEST_URL=http://localhost:8000/ingest
PROBE_INGEST_TOKEN=dev-token-change-me
PROBE_LOCAL_BASE=http://reference.local
PROBE_CLOUD_BASE=https://comp702-ref.azurewebsites.net
PROBE_REAL_WEB=https://www.bbc.co.uk/news
PROBE_REAL_VIDEO=
PROBE_REAL_DOWNLOAD=
PROBE_REAL_IMAP_HOST=
PROBE_REAL_IMAP_USER=
PROBE_REAL_IMAP_PASS=
# cadences: light app workloads every 5 min, bandwidth-heavy ones hourly
PROBE_HEAVY_INTERVAL_S=300
PROBE_TRANSFER_INTERVAL_S=3600

# --- Backend ---
API_INGEST_TOKEN=dev-token-change-me
API_DATABASE_URL=postgresql+psycopg://wifi:wifi@localhost:5432/wifi
API_BLOB_CONN_STR=
# dashboard basic auth; empty password = auth off (local dev only)
API_DASH_USER=wifi
API_DASH_PASS=

# --- Grafana provisioning ---
DB_HOST=localhost
DB_PASSWORD=wifi
