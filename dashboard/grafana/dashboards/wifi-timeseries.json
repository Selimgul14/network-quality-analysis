{
  "uid": "wifi-timeseries",
  "title": "WiFi Performance: time series",
  "tags": [
    "comp702"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Web page load",
      "datasource": {
        "type": "postgres",
        "uid": "wifi-timescale"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "wifi-timescale"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"time\", endpoint AS metric, (metrics->>'load_ms')::float AS value FROM measurement WHERE workload='web' AND ok AND metrics->>'load_ms' IS NOT NULL AND $__timeFilter(ts) ORDER BY 1"
        }
      ]
    },
