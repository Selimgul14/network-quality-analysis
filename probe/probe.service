# systemd unit for the probe. Copy to /etc/systemd/system/, then:
#   sudo systemctl enable --now probe
[Unit]
Description=Remote WiFi Performance Tool probe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/probe
EnvironmentFile=/opt/probe/.env
ExecStart=/opt/probe/.venv/bin/python -m probe.main
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
